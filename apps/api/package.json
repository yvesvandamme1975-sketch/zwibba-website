{
  "name": "@zwibba/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "seed:locations": "tsx scripts/seed-location-options.ts",
    "seed:system-listings": "tsx scripts/seed-system-listings.ts",
    "start": "npm run prisma:migrate:deploy && tsx src/main.ts",
    "test": "node ./scripts/run-tests.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/client": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "typescript": "^5.9.3"
  }
}
