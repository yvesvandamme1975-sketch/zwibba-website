NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://zwibba:replace-me@railway.internal:5432/railway
APP_BASE_URL=https://zwibba-api.up.railway.app
AI_PROVIDER=mistral
AI_GOOGLE_VISION_ENRICHMENT_ENABLED=false
MISTRAL_API_KEY=replace-me
MISTRAL_MODEL=pixtral-12b-2409
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash-lite
GOOGLE_CLOUD_PROJECT_ID=replace-me
GOOGLE_CLOUD_VISION_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OTP_PROVIDER=demo
DEMO_OTP_ALLOWLIST=+243990000001
DEMO_OTP_CODE=123456
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_TEMPLATE_NAME=
META_WHATSAPP_TEMPLATE_LANG=
META_GRAPH_API_VERSION=
# WhatsApp support agent (apps/api/src/support) — see apps/api/src/support/README.md
# Value you set as the "Verify token" when configuring the Meta webhook.
WHATSAPP_VERIFY_TOKEN=replace-me
# App Secret from the Meta app dashboard; used to verify the X-Hub-Signature-256
# HMAC on every inbound webhook POST.
META_APP_SECRET=replace-me
# Mailbox that receives escalation emails for unresolved conversations.
SUPPORT_ESCALATION_EMAIL=hello@aivesconsulting.com
# API key for the transactional email provider (Resend-shaped: POST /emails).
SUPPORT_EMAIL_API_KEY=replace-me
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=zwibba-media
R2_PUBLIC_BASE_URL=https://cdn.zwibba.com
R2_S3_ENDPOINT=https://replace-me.r2.cloudflarestorage.com
